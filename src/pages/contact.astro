---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mauricio Meza — mechanical designer, mechatronics engineer, Phoenix AZ."
>
  <section class="max-w-2xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-primary mb-3">Contact</h1>
    <p class="text-muted mb-10 max-w-md">
      Available for mechanical design roles, robotics collaborations, and engineering conversations.
      Reach out directly or use the form below.
    </p>

    <!-- Direct links -->
    <div class="flex flex-col gap-3 mb-12">
      <a
        href="mailto:mauriciomeza0110@gmail.com"
        class="inline-flex items-center gap-3 text-sm text-muted hover:text-bright transition-colors"
      >
        <span class="font-mono text-bright">@</span>
        mauriciomeza0110@gmail.com
      </a>
      <a
        href="https://linkedin.com/in/cs-mmeza"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 text-sm text-muted hover:text-bright transition-colors"
      >
        <span class="font-mono text-bright">in</span>
        linkedin.com/in/cs-mmeza
      </a>
      <a
        href="https://github.com/cs-mmeza"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 text-sm text-muted hover:text-bright transition-colors"
      >
        <span class="font-mono text-bright">gh</span>
        github.com/cs-mmeza
      </a>
    </div>

    <!-- mailto form -->
    <form
      action="mailto:mauriciomeza0110@gmail.com"
      method="get"
      enctype="text/plain"
      class="flex flex-col gap-5"
    >
      <div>
        <label for="name" class="block text-xs font-mono text-muted uppercase mb-2">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full bg-surface border border-accent/30 rounded px-4 py-2.5 text-sm text-primary placeholder-muted/50 focus:outline-none focus:border-bright transition-colors"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="subject" class="block text-xs font-mono text-muted uppercase mb-2">Subject</label>
        <input
          id="subject"
          name="subject"
          type="text"
          required
          class="w-full bg-surface border border-accent/30 rounded px-4 py-2.5 text-sm text-primary placeholder-muted/50 focus:outline-none focus:border-bright transition-colors"
          placeholder="What's this about?"
        />
      </div>
      <div>
        <label for="body" class="block text-xs font-mono text-muted uppercase mb-2">Message</label>
        <textarea
          id="body"
          name="body"
          rows="5"
          required
          class="w-full bg-surface border border-accent/30 rounded px-4 py-2.5 text-sm text-primary placeholder-muted/50 focus:outline-none focus:border-bright transition-colors resize-none"
          placeholder="Your message..."
        ></textarea>
      </div>
      <button
        type="submit"
        class="self-start px-6 py-3 bg-accent hover:bg-bright text-white font-semibold rounded transition-colors text-sm"
      >
        Open in Mail
      </button>
    </form>
  </section>
</BaseLayout>
