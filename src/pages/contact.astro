---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mauricio Meza — mechanical designer, mechatronics engineer, Phoenix AZ."
>
  <section class="max-w-2xl mx-auto px-6 py-14">
    <p class="section-label mb-3">Get in touch</p>
    <h1 class="text-4xl font-bold text-primary tracking-tight mb-4">Contact</h1>
    <p class="text-base text-muted-2 mb-12 max-w-md leading-relaxed">
      Available for mechanical design roles, robotics collaborations, and engineering conversations.
      Reach out directly or use the form below.
    </p>

    <!-- Direct links -->
    <div class="flex flex-col gap-4 mb-14 border-l-2 border-accent/30 pl-5">
      <a
        href="mailto:mauriciomeza0110@gmail.com"
        class="group flex items-center gap-3 text-sm text-muted-2 hover:text-primary transition-colors duration-200"
      >
        <span class="font-mono text-accent text-xs w-4">@</span>
        <span class="group-hover:text-bright transition-colors">mauriciomeza0110@gmail.com</span>
      </a>
      <a
        href="https://linkedin.com/in/cs-mmeza"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 text-sm text-muted-2 hover:text-primary transition-colors duration-200"
      >
        <span class="font-mono text-accent text-xs w-4">in</span>
        <span class="group-hover:text-bright transition-colors">linkedin.com/in/cs-mmeza</span>
      </a>
      <a
        href="https://github.com/cs-mmeza"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 text-sm text-muted-2 hover:text-primary transition-colors duration-200"
      >
        <span class="font-mono text-accent text-xs w-4">gh</span>
        <span class="group-hover:text-bright transition-colors">github.com/cs-mmeza</span>
      </a>
    </div>

    <!-- Form -->
    <form
      action="mailto:mauriciomeza0110@gmail.com"
      method="get"
      enctype="text/plain"
      class="flex flex-col gap-6"
    >
      <div class="flex flex-col gap-2">
        <label for="name" class="text-[10px] font-mono text-accent uppercase tracking-widest">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="bg-surface border border-white/[0.08] rounded-lg px-4 py-3 text-sm text-primary placeholder:text-muted/40 focus:outline-none focus:border-bright/40 focus:bg-surface-2 transition-all duration-200"
          placeholder="Your name"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="subject" class="text-[10px] font-mono text-accent uppercase tracking-widest">Subject</label>
        <input
          id="subject"
          name="subject"
          type="text"
          required
          class="bg-surface border border-white/[0.08] rounded-lg px-4 py-3 text-sm text-primary placeholder:text-muted/40 focus:outline-none focus:border-bright/40 focus:bg-surface-2 transition-all duration-200"
          placeholder="What's this about?"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="body" class="text-[10px] font-mono text-accent uppercase tracking-widest">Message</label>
        <textarea
          id="body"
          name="body"
          rows="5"
          required
          class="bg-surface border border-white/[0.08] rounded-lg px-4 py-3 text-sm text-primary placeholder:text-muted/40 focus:outline-none focus:border-bright/40 focus:bg-surface-2 transition-all duration-200 resize-none"
          placeholder="Your message..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="self-start px-6 py-3 rounded-lg text-white font-semibold text-sm active:scale-[0.98] transition-transform duration-150"
        style="background: linear-gradient(135deg, #0e7490 0%, #0d9488 60%, #14b8a6 100%);"
      >
        Open in Mail
      </button>
    </form>
  </section>
</BaseLayout>
