---
import BaseLayout from '../layouts/BaseLayout.astro';

const resumeReady = false;
---

<BaseLayout
  title="Resume"
  description="Mauricio Meza — resume and professional summary."
>
  <section class="max-w-2xl mx-auto px-6 py-14">
    <p class="section-label mb-3">Professional summary</p>
    <h1 class="text-4xl font-bold text-primary tracking-tight mb-4">Resume</h1>
    <p class="text-base text-muted-2 mb-10 leading-relaxed">
      Full resume available as PDF. Hard copy available on request for applications.
    </p>

    {resumeReady ? (
      <a
        href="/resume.pdf"
        download
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white font-semibold text-sm active:scale-[0.98] transition-transform duration-150"
        style="background: linear-gradient(135deg, #0e7490 0%, #0d9488 60%, #14b8a6 100%);"
      >
        Download PDF
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v8M4 7l4 4 4-4"/><path d="M3 13h10"/></svg>
      </a>
    ) : (
      <div class="bg-surface border border-white/[0.07] rounded-xl p-5 text-sm text-muted font-mono">
        PDF coming soon — upload <code class="text-bright">public/resume.pdf</code> to enable download.
      </div>
    )}

    <div class="mt-14 flex flex-col gap-10">
      <div>
        <p class="section-label mb-5">Experience</p>
        <div class="flex flex-col gap-5">
          <div class="border-l-2 border-accent/40 pl-5">
            <p class="text-sm font-semibold text-primary">Mechanical Designer</p>
            <p class="text-xs font-mono text-muted mt-0.5">[Current Employer] · Phoenix, AZ · 2020 – Present</p>
          </div>
          <div class="border-l-2 border-accent/20 pl-5">
            <p class="text-sm font-semibold text-primary">Mechanical Designer</p>
            <p class="text-xs font-mono text-muted mt-0.5">Previous roles · 2017 – 2020</p>
          </div>
          <div class="border-l-2 border-accent/20 pl-5">
            <p class="text-sm font-semibold text-primary">Mechatronics / Automation Engineer</p>
            <p class="text-xs font-mono text-muted mt-0.5">Mexico · 2013 – 2017</p>
          </div>
        </div>
      </div>

      <div>
        <p class="section-label mb-5">Education</p>
        <div class="flex flex-col gap-4">
          <div class="border-l-2 border-accent/40 pl-5">
            <p class="text-sm font-semibold text-primary">MS Robotics & Autonomous Systems</p>
            <p class="text-xs font-mono text-muted mt-0.5">ASU · EE concentration · Planned 2027</p>
          </div>
          <div class="border-l-2 border-accent/20 pl-5">
            <p class="text-sm font-semibold text-primary">BSEE — Mechatronics Engineering</p>
            <p class="text-xs font-mono text-muted mt-0.5">ITESCA · 2013</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
