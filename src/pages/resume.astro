---
import BaseLayout from '../layouts/BaseLayout.astro';

// Set to true once public/resume.pdf is added
const resumeReady = false;
---

<BaseLayout
  title="Resume"
  description="Mauricio Meza — resume and professional summary."
>
  <section class="max-w-2xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-primary mb-3">Resume</h1>
    <p class="text-muted mb-8">
      Full resume available as PDF. Hard copy available on request for applications.
    </p>

    {resumeReady ? (
      <a
        href="/resume.pdf"
        download
        class="inline-flex items-center gap-2 px-6 py-3 bg-accent hover:bg-bright text-white font-semibold rounded transition-colors text-sm"
      >
        Download PDF
      </a>
    ) : (
      <div class="bg-surface border border-accent/20 rounded-lg p-5 text-sm text-muted font-mono">
        PDF coming soon — upload <code class="text-bright">public/resume.pdf</code> to enable download.
      </div>
    )}

    <!-- Inline summary -->
    <div class="mt-12 flex flex-col gap-8">
      <div>
        <h2 class="text-xs font-mono text-muted uppercase tracking-widest mb-4">Experience</h2>
        <div class="flex flex-col gap-4">
          <div class="border-l-2 border-accent/30 pl-4">
            <p class="text-sm font-semibold text-primary">Mechanical Designer</p>
            <p class="text-xs text-muted font-mono">[Current Employer] · Phoenix, AZ · 2020 – Present</p>
          </div>
          <div class="border-l-2 border-accent/30 pl-4">
            <p class="text-sm font-semibold text-primary">Mechanical Designer</p>
            <p class="text-xs text-muted font-mono">Previous roles · 2017 – 2020</p>
          </div>
          <div class="border-l-2 border-accent/30 pl-4">
            <p class="text-sm font-semibold text-primary">Mechatronics / Automation Engineer</p>
            <p class="text-xs text-muted font-mono">Mexico · 2013 – 2017</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-xs font-mono text-muted uppercase tracking-widest mb-4">Education</h2>
        <div class="flex flex-col gap-3">
          <div class="border-l-2 border-accent/30 pl-4">
            <p class="text-sm font-semibold text-primary">MS Robotics & Autonomous Systems</p>
            <p class="text-xs text-muted font-mono">ASU · EE concentration · Planned 2027</p>
          </div>
          <div class="border-l-2 border-accent/30 pl-4">
            <p class="text-sm font-semibold text-primary">BSEE — Mechatronics Engineering</p>
            <p class="text-xs text-muted font-mono">ITESCA · 2013</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
