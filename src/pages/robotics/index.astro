---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('robotics', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Robotics Projects"
  description="ROS 2, Python, computer vision, and autonomous systems projects as part of my MS Robotics path at ASU."
>
  <section class="max-w-6xl mx-auto px-6 py-14">
    <div class="mb-12">
      <p class="section-label mb-3">Autonomous Systems</p>
      <h1 class="text-4xl font-bold text-primary tracking-tight mb-4">Robotics Projects</h1>
      <p class="text-base text-muted-2 max-w-xl leading-relaxed">
        Autonomous navigation, kinematics, 3D perception, and deep learning projects
        built while deepening my path toward ASU's MS Robotics & Autonomous Systems program.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((project, i) => (
        <a
          href={`/robotics/${project.id}`}
          class={`group bg-surface border border-white/[0.07] rounded-xl p-6 hover:border-bright/20 hover:bg-surface-2 transition-all duration-300 ${i === 0 ? 'md:col-span-2' : ''}`}
        >
          <div class="flex items-start justify-between mb-5">
            <span class="text-[10px] font-mono text-accent uppercase tracking-widest">{project.data.industry}</span>
            <span class="text-[10px] font-mono text-muted">{project.data.year}</span>
          </div>
          <h2 class={`font-semibold text-primary group-hover:text-bright transition-colors mb-2 ${i === 0 ? 'text-2xl' : 'text-lg'}`}>
            {project.data.title}
          </h2>
          <p class="text-sm text-muted mb-5 leading-relaxed">{project.data.role}</p>
          <div class="flex flex-wrap gap-1.5">
            {project.data.tools.map((tool: string) => (
              <span class="text-[10px] font-mono bg-accent/[0.08] border border-accent/[0.15] px-2 py-0.5 rounded text-accent/80">
                {tool}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
