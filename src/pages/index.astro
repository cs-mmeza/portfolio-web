---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const recentWork = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const recentRobotics = (await getCollection('robotics', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout title="Home" description="Mauricio Meza — Mechanical Designer & Mechatronics Engineer, CSWP certified, Phoenix AZ.">

  <!-- Hero -->
  <section class="relative max-w-6xl mx-auto px-6 pt-20 pb-20 overflow-hidden">
    <!-- Dot grid texture -->
    <div class="dot-grid absolute inset-0 pointer-events-none" aria-hidden="true" />

    <!-- Ambient teal glow -->
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full pointer-events-none"
      style="background: radial-gradient(circle, rgba(13, 148, 136, 0.12) 0%, transparent 70%);"
      aria-hidden="true" />

    <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between gap-12">
      <!-- Text -->
      <div class="flex-1 max-w-2xl">
        <div class="inline-flex items-center gap-2 border border-accent/30 bg-accent/[0.07] rounded-full px-3 py-1 mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-bright animate-pulse" />
          <span class="text-[11px] font-mono text-accent tracking-widest uppercase">CSWP Certified</span>
        </div>

        <h1 class="text-5xl md:text-6xl font-bold text-primary tracking-tighter leading-[1.05] mb-4">
          Mauricio<br/>Meza
        </h1>

        <p class="text-base font-mono text-bright mb-1 tracking-wide">
          Mechanical Designer · Mechatronics Engineer
        </p>
        <p class="text-sm text-muted font-mono mb-7">
          Phoenix, AZ · MS Robotics candidate, ASU 2027
        </p>

        <p class="text-base text-muted-2 max-w-lg leading-relaxed mb-10">
          7+ years designing fixtures, structural assemblies, and manufacturing tooling.
          BSEE in Mechatronics with a decade of automation and controls background.
          Bridging precision mechanical design with robotics and autonomous systems.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/work"
            class="btn-primary inline-flex items-center justify-center px-6 py-3 rounded-lg text-sm"
            style="background: linear-gradient(135deg, #0e7490 0%, #0d9488 60%, #14b8a6 100%);"
          >
            View Design Work
            <svg class="ml-2 w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a
            href="/robotics"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-white/[0.12] text-primary/80 hover:text-primary hover:border-bright/30 text-sm font-medium transition-colors duration-200"
          >
            Robotics Projects
          </a>
        </div>
      </div>

      <!-- Avatar -->
      <div class="flex-shrink-0">
        <div
          class="w-36 h-36 md:w-44 md:h-44 rounded-full flex items-center justify-center teal-ring"
          style="background: linear-gradient(135deg, #0b1623 0%, #0f2235 100%); border: 1px solid rgba(45, 212, 191, 0.2);"
        >
          <span class="text-3xl md:text-4xl font-bold tracking-tighter"
            style="background: linear-gradient(135deg, #2dd4bf, #67e8f9); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            MM
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Currently -->
  <section class="max-w-6xl mx-auto px-6 py-10 border-t border-white/[0.05]">
    <p class="section-label mb-5">Currently</p>
    <ul class="flex flex-col gap-3">
      <li class="flex items-start gap-3 text-sm">
        <span class="mt-0.5 w-1 h-1 rounded-full bg-bright flex-shrink-0 mt-2" />
        <span class="text-muted-2">Mechanical Designer at [Current Employer] — Phoenix, AZ</span>
      </li>
      <li class="flex items-start gap-3 text-sm">
        <span class="mt-0.5 w-1 h-1 rounded-full bg-bright flex-shrink-0 mt-2" />
        <span class="text-muted-2">Preparing ASU MS Robotics & Autonomous Systems application (EE) — Spring 2027</span>
      </li>
      <li class="flex items-start gap-3 text-sm">
        <span class="mt-0.5 w-1 h-1 rounded-full bg-bright flex-shrink-0 mt-2" />
        <span class="text-muted-2">Deepening ROS 2, control theory, and Python robotics stack</span>
      </li>
    </ul>
  </section>

  <!-- Recent Design Work -->
  {recentWork.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-10 border-t border-white/[0.05]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="section-label mb-2">Design Work</p>
          <h2 class="text-xl font-semibold text-primary tracking-tight">Mechanical &amp; Industrial</h2>
        </div>
        <a href="/work" class="text-xs font-mono text-muted hover:text-bright transition-colors">
          All projects →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {recentWork.map((project, i) => (
          <a
            href={`/work/${project.id}`}
            class={`group relative bg-surface border border-white/[0.07] rounded-xl p-6 hover:border-bright/20 hover:bg-surface-2 transition-all duration-300 ${i === 0 ? 'md:col-span-2' : ''}`}
          >
            <div class="flex items-start justify-between mb-4">
              <span class="text-[10px] font-mono text-accent tracking-widest uppercase">{project.data.industry}</span>
              <span class="text-[10px] font-mono text-muted">{project.data.year}</span>
            </div>
            <h3 class={`font-semibold text-primary group-hover:text-bright transition-colors mb-2 ${i === 0 ? 'text-xl' : 'text-base'}`}>
              {project.data.title}
            </h3>
            <p class="text-xs text-muted mb-4">{project.data.role}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.data.tools.slice(0, i === 0 ? 5 : 3).map((tool: string) => (
                <span class="text-[10px] font-mono bg-accent/[0.08] border border-accent/[0.15] px-2 py-0.5 rounded text-accent/80">
                  {tool}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Recent Robotics -->
  {recentRobotics.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-10 border-t border-white/[0.05]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="section-label mb-2">Robotics</p>
          <h2 class="text-xl font-semibold text-primary tracking-tight">Autonomous Systems</h2>
        </div>
        <a href="/robotics" class="text-xs font-mono text-muted hover:text-bright transition-colors">
          All projects →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {recentRobotics.map((project, i) => (
          <a
            href={`/robotics/${project.id}`}
            class={`group relative bg-surface border border-white/[0.07] rounded-xl p-6 hover:border-bright/20 hover:bg-surface-2 transition-all duration-300 ${i === 0 ? 'md:col-span-2' : ''}`}
          >
            <div class="flex items-start justify-between mb-4">
              <span class="text-[10px] font-mono text-accent tracking-widest uppercase">{project.data.industry}</span>
              <span class="text-[10px] font-mono text-muted">{project.data.year}</span>
            </div>
            <h3 class={`font-semibold text-primary group-hover:text-bright transition-colors mb-2 ${i === 0 ? 'text-xl' : 'text-base'}`}>
              {project.data.title}
            </h3>
            <p class="text-xs text-muted mb-4">{project.data.role}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.data.tools.slice(0, i === 0 ? 5 : 3).map((tool: string) => (
                <span class="text-[10px] font-mono bg-accent/[0.08] border border-accent/[0.15] px-2 py-0.5 rounded text-accent/80">
                  {tool}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Recent Blog Posts -->
  {recentPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-10 border-t border-white/[0.05]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="section-label mb-2">Writing</p>
          <h2 class="text-xl font-semibold text-primary tracking-tight">Recent Posts</h2>
        </div>
        <a href="/blog" class="text-xs font-mono text-muted hover:text-bright transition-colors">
          All posts →
        </a>
      </div>

      <div class="flex flex-col divide-y divide-white/[0.05]">
        {recentPosts.map(post => (
          <a href={`/blog/${post.id}`} class="group flex items-start gap-6 py-5 hover:bg-surface/40 -mx-4 px-4 rounded-lg transition-colors duration-200">
            <span class="text-xs font-mono text-muted w-20 flex-shrink-0 pt-0.5">
              {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            </span>
            <span class="text-sm text-muted-2 group-hover:text-primary transition-colors leading-relaxed">{post.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>
