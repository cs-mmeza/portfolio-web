---
const navLinks = [
  { href: '/work', label: 'Design Work' },
  { href: '/robotics', label: 'Robotics' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/[0.06]" style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(7, 12, 20, 0.82);">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex flex-col leading-tight group">
      <span class="font-semibold text-base text-primary tracking-tight group-hover:text-bright transition-colors duration-200">Mauricio Meza</span>
      <span class="text-[10px] text-accent font-mono tracking-widest uppercase">Mech. Designer · Mechatronics</span>
    </a>

    <ul class="hidden md:flex items-center gap-1">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              class={`relative text-sm px-3 py-1.5 rounded font-medium transition-colors duration-200 ${
                isActive
                  ? 'text-bright'
                  : 'text-muted-2 hover:text-primary'
              }`}
            >
              {label}
              {isActive && (
                <span class="absolute inset-x-3 -bottom-[17px] h-px bg-bright/60" />
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <button
      id="mobile-menu-toggle"
      class="md:hidden text-muted-2 hover:text-primary transition-colors p-1"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.06] px-6 py-4" style="background: rgba(7, 12, 20, 0.95);">
    <ul class="flex flex-col gap-1">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="block text-sm py-2 px-3 rounded text-muted-2 hover:text-primary hover:bg-white/[0.04] transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
