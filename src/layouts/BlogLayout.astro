---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  slug: string;
  wordCount?: number;
}

const { title, date, description, tags, slug, wordCount = 800 } = Astro.props;
const readingTime = Math.ceil(wordCount / 200);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = allPosts.findIndex(p => p.id === slug);
const prev = allPosts[currentIndex + 1] ?? null;
const next = allPosts[currentIndex - 1] ?? null;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-14">

    <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-mono text-muted hover:text-bright transition-colors duration-200">
      <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 12L6 8l4-4"/></svg>
      Back to Blog
    </a>

    <header class="mt-8 mb-10 pb-8 border-b border-white/[0.06]">
      <div class="flex flex-wrap items-center gap-2 mb-5">
        {tags.map(tag => (
          <span class="text-[10px] font-mono bg-accent/[0.08] border border-accent/[0.15] px-2 py-0.5 rounded text-accent/80 uppercase tracking-widest">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-3xl font-bold text-primary tracking-tight mb-3">{title}</h1>
      <p class="text-sm font-mono text-muted">
        {date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        <span class="text-white/20 mx-2">·</span>
        {readingTime} min read
      </p>
    </header>

    <div class="prose prose-invert prose-sm max-w-none
      prose-headings:font-bold prose-headings:text-primary prose-headings:tracking-tight
      prose-p:text-muted-2 prose-p:leading-relaxed
      prose-strong:text-primary prose-a:text-bright prose-a:no-underline hover:prose-a:underline">
      <slot />
    </div>

    <div class="mt-16 pt-8 border-t border-white/[0.06] flex justify-between gap-4">
      {prev ? (
        <a href={`/blog/${prev.id}`} class="text-sm text-muted hover:text-bright transition-colors">
          ← {prev.data.title}
        </a>
      ) : <span />}
      {next ? (
        <a href={`/blog/${next.id}`} class="text-sm text-muted hover:text-bright transition-colors text-right">
          {next.data.title} →
        </a>
      ) : <span />}
    </div>

  </article>
</BaseLayout>
